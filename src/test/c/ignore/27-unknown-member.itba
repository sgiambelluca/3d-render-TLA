// Referencia a un atributo inexistente.
scene "a" {
	camera main at (0, 2, 5) {
		look_at (0, 0, 0)
		fov 60deg
	}
	material m { color #ffffff shininess 1 }
	mesh a : sphere at (0, 0, 0) { radius 1 material m }
	mesh b : sphere at a.pos + (a.size.y, 0, 0) { radius 1 material m }
	render (640, 480) to "x.html"
}
