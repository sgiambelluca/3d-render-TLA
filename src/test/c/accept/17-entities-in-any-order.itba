// Las entidades pueden declararse en cualquier orden.
scene "desordenada" {
	render (640, 480) to "desordenada.html"
	mesh bola : sphere at (0, 1, 0) {
		material piedra
		radius 1
	}
	material piedra { shininess 2 color #777777 }
	light sol : directional {
		intensity 0.7
		color #ffffff
		direction (1, -1, 0)
	}
	camera main at (0, 2, 6) {
		fov 60deg
		look_at bola
	}
}
