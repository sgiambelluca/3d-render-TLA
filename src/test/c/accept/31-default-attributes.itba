// Atributos con valor por defecto: color e intensidad de luz, brillo, posicion y material de malla.
scene "a" {
	camera main at (0, 2, 5) {
		look_at (0, 0, 0)
		fov 60deg
	}
	light sol : directional { direction (0, -1, 0) }
	light foco : point at (0, 3, 0) { intensity sol.intensity / 2 }
	material m { color sol.color }
	mesh a : sphere { radius 1 + m.shininess }
	mesh b : box at a.pos + (3, 0, 0) { size 1 material m }
	render (640, 480) to "x.html"
}
