// Cadenas de referencias: el material de una malla, su color, y componentes de la posicion.
scene "a" {
	camera main at (0, 2, 5) {
		look_at (0, 0, 0)
		fov 60deg
	}
	material m { color #336699 shininess 4 }
	material copia { color b.material.color shininess b.material.shininess * 2 }
	mesh a : sphere { radius 1 material copia }
	mesh b : box at (a.pos.x + 2, a.pos.y, main.pos.z / 5) { size 1 material m }
	mesh c : box at (b.pos.x * 2, 0, 0) { size b.size.z material a.material }
	render (640, 480) to "x.html"
}
